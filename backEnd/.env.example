# Set this to the MongoDB Atlas connection string for the existing database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/SmartAttendanceDB
MONGODB_DB_NAME=SmartAttendanceDB
RUN_EMPLOYEE_MIGRATION=false
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@smartattendance.com
ADMIN_PASSWORD=replace-with-a-secure-password
DEFAULT_EMPLOYEE_PASSWORD=replace-with-a-unique-strong-password
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=
EMAIL_FROM=Smart Attendance <your-sending-account@gmail.com>
API_RATE_LIMIT_MAX=100
ADMIN_MESSAGES_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_VERIFY_RATE_LIMIT_MAX=15
CONTACT_RATE_LIMIT_MAX=5
ATTENDANCE_SCAN_RATE_LIMIT_MAX=10
FACE_REGISTER_RATE_LIMIT_MAX=1200
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=60000
# Set to the trusted reverse-proxy hop count only when deployed behind a proxy.
TRUST_PROXY_HOPS=0
